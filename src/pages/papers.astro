---
import BaseLayout from "../layouts/BaseLayout.astro";
import HorizontalCard from "../components/HorizontalCard.astro";
---

<BaseLayout title = "My Papers" sideBarActiveItemID="papers">
  <div>
    <div class="text-3xl w-full font-bold mb-5">2025</div>
  </div>
  <HorizontalCard
    title="AgeML: Age Modeling With Machine Learning"
    desc="Jorge García Condado, Iñigo Tellaetxe-Elorriaga, Jesus M. Cortes and Asier Erramuzpe"
    url="https://doi.org/10.1109/JBHI.2025.3531017"
    badge2="IEEE Journal of Biomedical and Health Informatics"
  />
  <div class="divider my-0"></div>
  <HorizontalCard
    title="Prognostic impact of germline deleterious variants and variants of uncertain significance in advanced prostate cancer: A call for functional elucidation."
    desc="Maitane Alonso Monasterio, Iñigo Tellaetxe Elorriaga, Ricardo Fernández, Sergio Carrera, Pablo Jiménez Labaig, Lorena Mosteiro, Manuela Vázquez, Jorge García-Olaverri, Ane Miren Iturregui, David Büchser, Alfonso Gómez-Iturriaga, Aranzazu Urresola, Iratxe Fernández, Estibaliz Iza, Eluska Iruarrizaga, Joan Manel Mañe, Xabier Elcoroaristizabal, Patricia Ruiz-Ontañón, Asier Erramuzpe, and Eneko Novo"
    url="https://doi.org/10.1002/acn3.70007"
    badge2="Journal of Clinical Oncology"
  />

</BaseLayout>
