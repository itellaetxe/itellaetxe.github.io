---
import BaseLayout from "../layouts/BaseLayout.astro";
import HorizontalCard from "../components/HorizontalCard.astro";
---

<BaseLayout title="Software Projects" sideBarActiveItemID="services">
  <div>
    <div class="text-3xl w-full font-bold mb-5">Projects</div>
  </div>

  <HorizontalCard
    title="AgeML"
    img="/ageml.png"
    desc="A Python package for Age Modeling with Machine Learning made easy."
    url="https://github.com/compneurobilbao/ageml"
    badge="Ageing"
  />
  <div class="divider my-0"></div>
  <HorizontalCard
    title="CompNeuro Tools"
    img="/compneuro_tools.png"
    desc="My personal collection of simple yet useful 'brain gardening tools' for my PhD works in CompNeuroBilbaoLab!"
    url="https://github.com/itellaetxe/compneuro_tools"
    badge="Neuroimaging Tools"
  />
  <div class="divider my-0"></div>
</BaseLayout>
